allow vendor_init proc_touchpanel:file { read write open };

# dt2w
get_prop(vendor_init, vendor_power_prop)

# pocket gesture (doze app -> init -> /proc/touchpanel/pocket_mode)
get_prop(vendor_init, sys_touch_prop)

# NTCamera (ro.vendor.nothing.* now typed vendor_nt_camera_prop)
set_prop(vendor_init, vendor_nt_camera_prop)
